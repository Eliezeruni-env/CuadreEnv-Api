{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OnionCrud": "Server=(localdb)\\MSSQLLocalDB;Database=onionCrud;Integrated Security=true;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "JwtConfiguration": {
    "Expiration": "00:30:00"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "onion-api",
    "Audience": "onion-api-audience"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/onion-log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "PreferredLanguage": "ES",
  "PriceProfile": "Basico"
}