{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OnionCrud": "Server=(localdb)\\MSSQLLocalDB;Database=CuadreEnv;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtConfiguration": {
    "Expiration": "00:30:00"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "onion-api",
    "Audience": "onion-api-audience"
  },
  "Usm": {
    "BaseUrl": "",
    "LicenseVerifyPath": "api/license/verify",
    "LicenseVerifyMethod": "POST",
    "ServiceName": "CuadreEnv",
    "InstanceId": "",
    "ApiKey": "",
    "ValidateOnStartup": true,
    "UseLocalDatabase": false,
    "CacheMinutes": 10,
    "TimeoutSeconds": 5,
    "StartupRetryCount": 2
  },
  "Dgii": {
    "BaseUrl": "",
    "SubmitPath": "api/fiscal/submit",
    "ApiKey": "",
    "TimeoutSeconds": 15
  },
  "Fiscal": {
    "PollSeconds": 5,
    "MaxAttempts": 8
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "CuadreEnv",
    "EnableSsl": true
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/onion-log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "PreferredLanguage": "ES",
  "PriceProfile": "Basico",
  "Internal": {
    "ApiKey": ""
  }
}